# WorkWise — Environment Variables
# Copy this file to .env and fill in real values

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://workwise:workwise_dev@localhost:5432/workwise_db

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 48
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_strong_random_secret_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Monitoring (optional) ──────────────────────────────────────────────────
# Sentry — get DSN from https://sentry.io
SENTRY_DSN=

# New Relic — get from https://one.newrelic.com
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=workwise-api

# ─── AWS (optional) ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=workwise-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── AI (optional) ──────────────────────────────────────────────────────────
# At least one of these is needed for AI features
OPENAI_API_KEY=
GEMINI_API_KEY=
